# Copyright (C) 2024 Recovery Tree Rebuild for Infinix X695C
# SPDX-License-Identifier: Apache-2.0
#
# Recovery FSTAB for Infinix X695C (MT6785)
# FBE Encryption: aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized
#

# ============================================================================
# LOGICAL PARTITIONS (Super Partition)
# ============================================================================
/system                   ext4    system                                                   flags=display=system;logical;slotselect
/system_ext               ext4    system_ext                                               flags=display=system_ext;logical;slotselect
/vendor                   ext4    vendor                                                   flags=display=vendor;logical;slotselect
/product                  ext4    product                                                  flags=display=product;logical;slotselect

# ============================================================================
# USERDATA & METADATA
# ============================================================================
/metadata                 ext4    /dev/block/platform/bootdevice/by-name/md_udc            flags=display=metadata
/data                     f2fs    /dev/block/platform/bootdevice/by-name/userdata          flags=display=data;encryptable=footer;length=-16384;fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized;keydirectory=/metadata/vold/metadata_encryption

# ============================================================================
# BOOT PARTITIONS (A/B Slots)
# ============================================================================
/boot                     emmc    /dev/block/platform/bootdevice/by-name/boot              flags=display=boot;slotselect;backup=1
/boot_a                   emmc    /dev/block/platform/bootdevice/by-name/boot_a            flags=display=boot_a;slotselect
/boot_b                   emmc    /dev/block/platform/bootdevice/by-name/boot_b            flags=display=boot_b;slotselect
/dtbo                     emmc    /dev/block/platform/bootdevice/by-name/dtbo              flags=display=dtbo;slotselect;backup=1
/dtbo_a                   emmc    /dev/block/platform/bootdevice/by-name/dtbo_a            flags=display=dtbo_a;slotselect
/dtbo_b                   emmc    /dev/block/platform/bootdevice/by-name/dtbo_b            flags=display=dtbo_b;slotselect
/misc                     emmc    /dev/block/platform/bootdevice/by-name/misc              flags=display=misc

# ============================================================================
# VBMETA PARTITIONS (Android Verified Boot)
# ============================================================================
/vbmeta                   emmc    /dev/block/platform/bootdevice/by-name/vbmeta            flags=display=vbmeta;backup=1
/vbmeta_a                 emmc    /dev/block/platform/bootdevice/by-name/vbmeta_a          flags=display=vbmeta_a;slotselect
/vbmeta_b                 emmc    /dev/block/platform/bootdevice/by-name/vbmeta_b          flags=display=vbmeta_b;slotselect
/vbmeta_system            emmc    /dev/block/platform/bootdevice/by-name/vbmeta_system     flags=display=vbmeta_system;slotselect
/vbmeta_vendor            emmc    /dev/block/platform/bootdevice/by-name/vbmeta_vendor     flags=display=vbmeta_vendor;slotselect

# ============================================================================
# PROTECT PARTITIONS (NVRAM, IMEI, etc.)
# ============================================================================
/mnt/vendor/protect_f     ext4    /dev/block/platform/bootdevice/by-name/protect1          flags=display=protect_f
/mnt/vendor/protect_s     ext4    /dev/block/platform/bootdevice/by-name/protect2          flags=display=protect_s
/mnt/vendor/nvdata        ext4    /dev/block/platform/bootdevice/by-name/nvdata            flags=display=nvdata
/mnt/vendor/nvcfg         ext4    /dev/block/platform/bootdevice/by-name/nvcfg             flags=display=nvcfg
/mnt/vendor/persist       ext4    /dev/block/platform/bootdevice/by-name/persist           flags=display=persist

# ============================================================================
# EXTERNAL STORAGE (MicroSD & USB-OTG)
# ============================================================================
/auto                      auto    /devices/platform/externdevice*                          flags=display=auto;storage;removable
/auto                      vfat    /devices/platform/usb3_xhci*                             flags=display=auto;storage;removable

# ============================================================================
# FIRMWARE PARTITIONS
# ============================================================================
/persistent               emmc    /dev/block/platform/bootdevice/by-name/frp               flags=display=persistent
/nvram                    emmc    /dev/block/platform/bootdevice/by-name/nvram             flags=display=nvram;backup=1
/proinfo                  emmc    /dev/block/platform/bootdevice/by-name/proinfo           flags=display=proinfo;backup=1
/bootloader               emmc    /dev/block/platform/bootdevice/by-name/lk                flags=display=bootloader;backup=1
/bootloader2              emmc    /dev/block/platform/bootdevice/by-name/lk2               flags=display=bootloader2;backup=1
/logo                     emmc    /dev/block/platform/bootdevice/by-name/logo              flags=display=logo;backup=1
/logo_a                   emmc    /dev/block/platform/bootdevice/by-name/logo_a            flags=display=logo_a
/logo_b                   emmc    /dev/block/platform/bootdevice/by-name/logo_b            flags=display=logo_b
/expdb                    emmc    /dev/block/platform/bootdevice/by-name/expdb             flags=display=expdb
/seccfg                   emmc    /dev/block/platform/bootdevice/by-name/seccfg            flags=display=seccfg
/tee1                     emmc    /dev/block/platform/bootdevice/by-name/tee1              flags=display=tee1
/tee2                     emmc    /dev/block/platform/bootdevice/by-name/tee2              flags=display=tee2
/scp1                     emmc    /dev/block/platform/bootdevice/by-name/scp1              flags=display=scp1
/scp2                     emmc    /dev/block/platform/bootdevice/by-name/scp2              flags=display=scp2
/sspm_1                   emmc    /dev/block/platform/bootdevice/by-name/sspm_1            flags=display=sspm_1
/sspm_2                   emmc    /dev/block/platform/bootdevice/by-name/sspm_2            flags=display=sspm_2
/md1img                   emmc    /dev/block/platform/bootdevice/by-name/md1img            flags=display=md1img;backup=1
/gz1                      emmc    /dev/block/platform/bootdevice/by-name/gz1               flags=display=gz1
/gz2                      emmc    /dev/block/platform/bootdevice/by-name/gz2               flags=display=gz2
/spmfw                    emmc    /dev/block/platform/bootdevice/by-name/spmfw             flags=display=spmfw
