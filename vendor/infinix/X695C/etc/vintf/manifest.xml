<manifest version="2.0" type="device" target-level="4">
    <!-- Keymaster HAL for FBE Decryption -->
    <hal format="hidl">
        <name>android.hardware.keymaster</name>
        <transport>hwbinder</transport>
        <version>4.0</version>
        <interface>
            <name>IKeymasterDevice</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Gatekeeper HAL -->
    <hal format="hidl">
        <name>android.hardware.gatekeeper</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IGatekeeper</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Health HAL -->
    <hal format="hidl">
        <name>android.hardware.health</name>
        <transport>hwbinder</transport>
        <version>2.1</version>
        <interface>
            <name>IHealth</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Boot Control HAL for A/B -->
    <hal format="hidl">
        <name>android.hardware.boot</name>
        <transport>hwbinder</transport>
        <version>1.1</version>
        <interface>
            <name>IBootControl</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Graphics Allocator HAL -->
    <hal format="hidl">
        <name>android.hardware.graphics.allocator</name>
        <transport>hwbinder</transport>
        <version>4.0</version>
        <interface>
            <name>IAllocator</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Graphics Mapper HAL -->
    <hal format="hidl">
        <name>android.hardware.graphics.mapper</name>
        <transport arch="32+64">passthrough</transport>
        <version>4.0</version>
        <interface>
            <name>IMapper</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Memtrack HAL -->
    <hal format="hidl">
        <name>android.hardware.memtrack</name>
        <transport>passthrough</transport>
        <version>1.0</version>
        <interface>
            <name>IMemtrack</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Lights HAL -->
    <hal format="hidl">
        <name>android.hardware.light</name>
        <transport>hwbinder</transport>
        <version>2.0</version>
        <interface>
            <name>ILight</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Vibrator HAL -->
    <hal format="hidl">
        <name>android.hardware.vibrator</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IVibrator</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Fastboot HAL -->
    <hal format="hidl">
        <name>android.hardware.fastboot</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IFastboot</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Kernel Configurations -->
    <kernel target-level="4"/>
    
    <!-- Sepolicy -->
    <sepolicy>
        <version>30.0</version>
    </sepolicy>
</manifest>
